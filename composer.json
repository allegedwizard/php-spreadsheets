{
    "name": "allegedwizard/php-spreadsheets",
    "description": "A spreadsheet parser wrapper utility, preferring OpenSpout with fallback to PhpSpreadsheet.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "AllegedWizard\\PhpSpreadsheets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AllegedWizard\\PhpSpreadsheets\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.0",
        "openspout/openspout": "^4.28",
        "phpoffice/phpspreadsheet": "^3.9",
        "league/csv": "^9.23"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
